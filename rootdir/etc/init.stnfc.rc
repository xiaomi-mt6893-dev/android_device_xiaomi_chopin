service nfc_hal_service /vendor/bin/hw/android.hardware.nfc-service.st
    override
    class hal
    user nfc
    group nfc
    disabled

on early-init && property:ro.boot.product.hardware.sku=choping
    setprop ro.boot.product.vendor.sku nfc

on early-init && property:ro.boot.product.hardware.sku=chopin
    setprop ro.boot.product.vendor.sku nfc

on init && property:ro.boot.product.vendor.sku=nfc
    start nfc_hal_service
